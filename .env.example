# video-agent-kit-local configuration reference.
# Copy only the entries you need into <plugin_root>/.env or <project_dir>/.env.
# Precedence: process environment > project .env > plugin .env.
# Do not put real secrets in this example file.
#
# Speech transcription runs LOCALLY through the Moss Transcribe WebUI CLI
# (`transcribe`). The CLI attaches to a running service or starts one
# automatically — no credentials, no cloud.

# Path to the transcribe executable. Leave unset when the cli/ folder of the
# Moss Transcribe WebUI deployment is already on PATH.
# VE_TRANSCRIBE_CMD=C:/AI/transcribe_cpp_webui/cli/transcribe.bat

# WebUI service address (default 127.0.0.1:8390). Only needed when the service
# runs on another host/port.
# VE_TRANSCRIBE_HOST=127.0.0.1
# VE_TRANSCRIBE_PORT=8390

# Auto-split long audio into N-minute chunks, 0 = off (default 30). The service
# splits precisely and corrects timestamps to the full-media timeline.
# VE_TRANSCRIBE_AUTOSPLIT=30

# Inference device name for the local service (see `transcribe --list-backend`).
# Leave unset to use whatever backend the running service already has loaded.
# VE_TRANSCRIBE_BACKEND=CUDA0

# --- Other plugin knobs (all optional) ---
# Extra CJK font directories, os.pathsep-separated. Windows/macOS system fonts
# are found automatically; this is for fonts in non-standard locations.
# VE_FONT_DIRS=D:\fonts

# pip mirror used by the venv bootstrap (default: Tsinghua).
# VE_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# Max images inlined in one MCP tool result before the rest are listed as paths
# (default 16; also settable per-install via the plugin's userConfig).
# VE_MAX_INLINE_IMAGES=16

# Override the plugin venv location (default: <plugin_root>/.venv).
# VE_VENV_DIR=
